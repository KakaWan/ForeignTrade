# ForeignTrade backend environment template
# Copy to .env and fill in what you need. The application can also run
# with the built-in defaults (SQLite + no AI key).
#
# Note: values saved from the Settings page go to backend/config.json and
# take precedence over this file.

# ── Application ──────────────────────────────────────────
DEBUG=false

# ── Database ─────────────────────────────────────────────
# Default: SQLite. The parent directory must exist before first start:
#   mkdir data
DB_ENGINE=sqlite
DB_URL=sqlite+aiosqlite:///./data/foreigntrade.db

# PostgreSQL is supported by the configuration layer, but asyncpg is not
# included in requirements.txt. Install it first if you switch:
#   pip install asyncpg
# DB_ENGINE=postgresql
# DB_URL=postgresql+asyncpg://user:password@localhost:5432/foreigntrade

# ── AI provider ──────────────────────────────────────────
# anthropic | openai
AI_PROVIDER=anthropic

# Anthropic Messages API
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-5

# OpenAI-compatible Chat Completions API
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

AI_MAX_TOKENS=8192
AI_TEMPERATURE=0.7

# ── Email deduction / verification ───────────────────────
# disabled | manual | auto
EMAIL_DEDUCE_MODE=disabled
# conservative | standard | comprehensive
EMAIL_DEDUCE_TEMPLATE_GROUP=standard

# disabled | manual | auto
EMAIL_VERIFY_MODE=manual
EMAIL_VERIFY_RATE_LIMIT=5
EMAIL_VERIFY_TIMEOUT=10
EMAIL_VERIFY_MX_REQUIRED=true

# ── HTTP ─────────────────────────────────────────────────
# JSON array; must include the frontend origin.
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]

# ── Backup ───────────────────────────────────────────────
BACKUP_ENABLED=false
BACKUP_INTERVAL=1
# minute | hour | day | week | month
BACKUP_UNIT=day
BACKUP_KEEP_COUNT=10

# ── SMTP (reserved; this version does not send email) ────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
